# Copy this file to .env and fill in your values. Never share .env or commit it.
ADMIN_PASSWORD=choose-a-strong-password

# Leave payments off for now: people register, you send payment links on WhatsApp.
# PAYMENTS=on
# WHATSAPP_NUMBER=917338884345   (already the default)

# Razorpay Dashboard (only needed when PAYMENTS=on) > switch to Test Mode (top of page) > Account & Settings > API Keys > Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed once the site is online (Razorpay Dashboard > Settings > Webhooks). Leave blank for local testing.
RAZORPAY_WEBHOOK_SECRET=

# Optional manual-UPI fallback
UPI_ID=
UPI_NAME=Core2CloudX

# Free hosted database (use this on Render's free plan, which has no disk). Leave blank locally.
TURSO_URL=
TURSO_AUTH_TOKEN=
